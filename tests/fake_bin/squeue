#!/usr/bin/env python3
"""Fake `squeue -h -r -o %i`: one line per pending task recorded by fake sbatch."""
import json
import os
from pathlib import Path

state = Path(os.environ.get("FAKE_SLURM_STATE", ".fake_slurm"))
for f in sorted(state.glob("*.json")):
    for t in json.loads(f.read_text())["pending"]:
        print(f"{f.stem}_{t}")
